{
    "bitbake.loggingLevel": "debug",
    "bitbake.pathToBitbakeFolder": "${workspaceFolder}/layers/bitbake",
    "bitbake.pathToEnvScript": "${workspaceFolder}/build/init-build-env",
    "bitbake.pathToBuildFolder": "${workspaceFolder}/build",
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/layers/bitbake/lib",
        "${workspaceFolder}/layers/openembedded-core/scripts",
        "${workspaceFolder}/layers/openembedded-core/meta/lib"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/layers/bitbake/lib",
        "${workspaceFolder}/layers/openembedded-core/scripts",
        "${workspaceFolder}/layers/openembedded-core/meta/lib"
    ],
    "task.saveBeforeRun": "always",
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.formatOnType": true,
        "editor.wordBasedSuggestions": "off",
        "files.trimTrailingWhitespace": false
    },
    "[shellscript]": {
        "files.eol": "\n",
        "files.trimTrailingWhitespace": false
    },
    "files.associations": {
        "*.txt": "diff",
        "*.conf": "bitbake",
        "*.inc": "bitbake"
    },
    "bitbake.buildConfigurations": [],
    "bitbake.commandWrapper": "",
    "bitbake.workingDirectory": "${workspaceFolder}"
}
