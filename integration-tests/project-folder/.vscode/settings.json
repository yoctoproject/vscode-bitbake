{
    "bitbake.loggingLevel": "debug",
    "bitbake.pathToBitbakeFolder": "${workspaceFolder}/sources/poky/bitbake",
    "bitbake.pathToEnvScript": "/workdir/integration-tests/project-folder/sources/poky/oe-init-build-env",
    "bitbake.pathToBuildFolder": "/workdir/integration-tests/project-folder/build-crops",
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib"
    ],
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.inlayHints.variableTypes": true,
    "task.saveBeforeRun": "always",
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.formatOnType": true,
        "editor.wordBasedSuggestions": "off",
        "files.trimTrailingWhitespace": false
    },
    "[shellscript]": {
        "files.eol": "\n",
        "files.trimTrailingWhitespace": false
    },
    "files.associations": {
        "*.txt": "diff",
        "*.patch": "diff",
        "diff": "diff",
        "*.conf": "bitbake",
        "*.inc": "bitbake"
    },
    "bitbake.buildConfigurations": [],
    "bitbake.commandWrapper": "",
    "bitbake.workingDirectory": "${workspaceFolder}"
}
